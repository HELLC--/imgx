{
  "name": "@imgx-kit/core",
  "version": "0.1.0",
  "description": "URL-driven image processing for Node.js. Compatible with Aliyun OSS x-oss-process syntax, powered by sharp.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.cjs",
    "./src/index.ts",
    "./src/operations/*.ts",
    "./src/operations/index.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "image",
    "image-processing",
    "sharp",
    "oss",
    "x-oss-process",
    "resize",
    "crop",
    "watermark",
    "convert",
    "nodejs"
  ],
  "author": "imgx contributors",
  "license": "MIT",
  "homepage": "https://imgx-gbom.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HELLC--/imgx.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/HELLC--/imgx/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "sharp": "^0.33.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
